APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
LOG_DIR=logs

AUTH_MODE=jwt
JWT_SECRET=change-me-in-local-only
JWT_ALGORITHM=HS256
SESSION_TTL_MINUTES=60

# Local Postgres — three separate DBs (auth ≠ risk ≠ stock). Change user if needed.
AUTH_DATABASE_URL=postgresql+psycopg://skoust@localhost:5432/frii_auth_db
DATABASE_URL=postgresql+psycopg://skoust@localhost:5432/frii_risk_db
STOCK_DATABASE_URL=postgresql+psycopg://skoust@localhost:5432/frii_stock_db

# openai | grok | gemini | groq | ollama
LLM_PROVIDER=openai
# Used when the primary provider fails (e.g. OpenAI quota exhausted)
LLM_FALLBACK_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_ROUTER=gpt-4o-mini
OPENAI_MODEL_AGENT=gpt-4o
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL_ROUTER=grok-4-fast
XAI_MODEL_AGENT=grok-4
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL_ROUTER=gemini-3.8-flash
GEMINI_MODEL_AGENT=gemini-3.8-flash
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_ROUTER=openai/gpt-oss-120b
GROQ_MODEL_AGENT=openai/gpt-oss-20b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
LLM_BASE_URL=
LLM_MODEL_ROUTER=
LLM_MODEL_AGENT=
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

RETRIEVAL_TOP_K=5
RETRIEVAL_TOP_K_MAX=10
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_WEAK_SCORE=0.2
# Hybrid search: weighted reciprocal rank fusion of pgvector cosine + keyword overlap
RETRIEVAL_VECTOR_WEIGHT=0.4
RETRIEVAL_LEXICAL_WEIGHT=0.6
RETRIEVAL_RRF_K=60
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=180
CHUNK_MIN_CHARS=40
CITATION_EXCERPT_CHARS=280

RISK_SCORE_MEDIUM=30
RISK_SCORE_HIGH=70
RISK_SCORE_ESCALATION=80
CONFIDENCE_ESCALATION_FLOOR=0.60
STALE_HIGH_RISK_DAYS=180
SECTOR_ALLOCATION_CAP=25
EMERGING_MARKET_CAP=15
DEFAULT_HOLDINGS_LIMIT=5
DEFAULT_MIN_ALLOCATION=10
MAX_SQL_ROWS=100

SEED_PASSWORD=Password123

CORPUS_LOCAL_PATH=Documents
CURRENT_FACTORS_ENABLED=true
MARKET_MAX_STALE_SECONDS=900
MARKET_HTTP_TIMEOUT_S=8
YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart/{symbol}
YAHOO_SEARCH_URL=https://query1.finance.yahoo.com/v1/finance/search
NEWS_MAX_AGE_HOURS=48
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
RATE_WINDOW_SECONDS=60
MAX_TOKENS_PER_REQUEST=8000
DAILY_BUDGET_USD=5.0
COST_TRACKING_ENABLED=true

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
