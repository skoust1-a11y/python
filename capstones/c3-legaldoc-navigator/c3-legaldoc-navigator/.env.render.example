# =============================================================================
# Render production environment variables
# Based on your local .env provider routing:
#   EMBEDDING_PROVIDER=google
#   DEFAULT_LLM_PROVIDER=groq
#   FALLBACK_LLM_PROVIDER=google
# =============================================================================
# Render does NOT read this file automatically.
# Copy each KEY=VALUE into: Render Dashboard → Environment → Add Environment Variable
# Replace ALL placeholder values with your real production secrets.
# Do NOT commit a filled-in copy with real keys.
# =============================================================================

# --- Render service settings (Dashboard → Settings) ---
# PYTHON_VERSION=3.12.7
# Build Command:  pip install --upgrade pip && pip install -r requirements.txt
# Start Command:  alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port $PORT
# Health Check:   /health

# --- Application ---
APP_NAME=C3 LegalDoc Navigator
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
SECRET_KEY=your-production-secret-key

# Update after Vercel deploy
CORS_ORIGINS=["https://your-app.vercel.app"]

# --- Neon PostgreSQL (replace local DATABASE_URL) ---
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_SYNC_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Qdrant ---
VECTOR_BACKEND=qdrant
VECTOR_DIMENSION=1536
VECTOR_TABLE_NAME=document_embeddings
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=document_embeddings

# --- S3 / R2 storage ---
STORAGE_BACKEND=s3
S3_BUCKET=legal-documents
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=auto
S3_PATH_PREFIX=uploads
S3_ENDPOINT_URL=
TEMP_UPLOAD_DIR=./tmp/uploads

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt"]

# --- Provider routing (from your .env) ---
EMBEDDING_PROVIDER=google
DEFAULT_LLM_PROVIDER=groq
FALLBACK_LLM_PROVIDER=google

# --- Google / Gemini (required — embeddings + fallback chat) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Groq (required — primary chat) ---
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.1-8b-instant

# --- OpenAI (optional — not used in your routing, but keep if you want) ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Anthropic (not required for your routing) ---
# ANTHROPIC_API_KEY=...
# ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# --- RAG (from your .env) ---
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
SCOPED_SIMILARITY_THRESHOLD=0.45
SCOPED_TOP_K_RETRIEVAL=10
ENABLE_CONTEXT_COMPRESSION=true
MAX_CONTEXT_TOKENS=6000
CONTEXT_COMPRESSION_RELEVANCE_THRESHOLD=0.15
CONTEXT_COMPRESSION_NEAR_DUPLICATE_JACCARD_THRESHOLD=0.90
CONTEXT_COMPRESSION_MIN_SENTENCE_CHARS=20

# Evidence mode — minimum retrieval quality before listing supporting clauses
EVIDENCE_RELEVANCE_THRESHOLD=0.20
EVIDENCE_MIN_CHUNK_SIMILARITY=0.35
EVIDENCE_QUERY_OVERLAP_THRESHOLD=0.15

# Response modes (set true to re-enable Analysis mode LLM execution)
ENABLE_ANALYSIS_MODE=false

# --- Guardrails (from your .env) ---
ENABLE_GUARDRAILS=true
MAX_QUERY_LENGTH=2000
GUARDRAILS_RUN_SYNC=true
HANDOFF_CONFIDENCE_THRESHOLD=0.70

# --- Langfuse (from your .env) ---
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# --- MCP ---
MCP_ENABLED=false
MCP_SEARCH_TIMEOUT_SECONDS=30
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_MIN_WAIT_SECONDS=1
MCP_RETRY_MAX_WAIT_SECONDS=10
MCP_SERVERS=[]
