# Application
APP_NAME=C3 LegalDoc Navigator
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=legaldoc
POSTGRES_PASSWORD=legaldoc_secret
POSTGRES_DB=legaldoc_navigator
DATABASE_URL=postgresql+asyncpg://legaldoc:legaldoc_secret@localhost:5432/legaldoc_navigator
DATABASE_SYNC_URL=postgresql+psycopg2://legaldoc:legaldoc_secret@localhost:5432/legaldoc_navigator

# pgvector
VECTOR_DIMENSION=1536
VECTOR_TABLE_NAME=document_embeddings

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# LLM routing
DEFAULT_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=anthropic

# RAG
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7

# Ingestion
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt"]

# Guardrails (Guardrails AI validators)
ENABLE_GUARDRAILS=true
MAX_QUERY_LENGTH=2000
GUARDRAILS_RUN_SYNC=true

# Langfuse observability
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# RAG evaluation (RAGAS benchmarks)
EVAL_OUTPUT_DIR=./data/evaluation/results
EVAL_BENCHMARK_PATH=./data/evaluation/benchmark.json
EVAL_RAGAS_MODEL=gpt-4o-mini
EVAL_LATENCY_THRESHOLD_MS=5000
EVAL_COST_THRESHOLD_USD=0.05

# External legal databases (Model Context Protocol)
MCP_ENABLED=false
MCP_SEARCH_TIMEOUT_SECONDS=30
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_MIN_WAIT_SECONDS=1
MCP_RETRY_MAX_WAIT_SECONDS=10
# JSON array of MCP server configs — example:
# MCP_SERVERS=[{"name":"courtlistener","transport":"sse","url":"https://api.example.com/mcp/sse","enabled":true,"search_tool":"search_cases","auth":{"type":"bearer","token_env":"COURTLISTENER_API_KEY"}}]
MCP_SERVERS=[]
