# Wellbeing Coach Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
# For Production (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/wellbeing_coach
# For Development (SQLite):
# DATABASE_URL=sqlite:///./wellbeing_coach.db

DB_USER=your_username
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wellbeing_coach

# Or use DATABASE_URL directly (takes precedence over individual DB_* vars)
# DATABASE_URL=postgresql+psycopg://skoust:password123@localhost:5432/wellbeing_coach

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=wellbeing_coach.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5
DEBUG=False

# API Configuration
API_TITLE=Wellbeing Coach
API_VERSION=1.0.0
RATE_LIMIT_PER_MINUTE=3

# Server Configuration
HOST=0.0.0.0
PORT=9000

# LLM Configuration
# Google Gemini API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama Local Model Configuration (for Gemma/local models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b

# Testing Configuration
TEST_WITH_MOCK_DATA=false

# For Testing (see .env.test for test-specific configuration)
# DATABASE_URL=sqlite:///./test.db
