# Autonomous Investment Strategy Board — environment template
# Copy this file to .env and fill in values. Never commit .env.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=Autonomous Investment Strategy Board
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Provider selection
# Business logic and agents must depend on provider contracts, not vendors.
# Change adapters here without modifying application code.
# LLM adapters: stub, openai, groq, google, azure
# Market adapters: stub, yahoo (live Yahoo Finance quotes and Indian indices)
# Fundamental / news adapters: stub (no external network calls)
# Selection is configuration-only. Do not hardcode a vendor in agents.
# -----------------------------------------------------------------------------
LLM_PROVIDER=stub
FALLBACK_LLM_PROVIDER=
LLM_TIMEOUT_SECONDS=30

OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_LLM_API_KEY=
OPENAI_LLM_BASE_URL=

GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_LLM_API_KEY=

AZURE_LLM_MODEL=
AZURE_LLM_API_KEY=
AZURE_LLM_ENDPOINT=
AZURE_LLM_API_VERSION=2024-10-21
AZURE_LLM_DEPLOYMENT=

GOOGLE_LLM_MODEL=gemini-2.0-flash
GOOGLE_LLM_API_KEY=

MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

FUNDAMENTAL_DATA_PROVIDER=stub
FUNDAMENTAL_DATA_API_KEY=
FUNDAMENTAL_DATA_BASE_URL=

NEWS_PROVIDER=stub
NEWS_API_KEY=
NEWS_BASE_URL=

# -----------------------------------------------------------------------------
# Portfolio upload (the only user-provided financial dataset)
# -----------------------------------------------------------------------------
PORTFOLIO_MAX_UPLOAD_BYTES=2097152
PORTFOLIO_UPLOAD_TTL_SECONDS=3600
