# Copy to `.env` and edit values for your environment.
# This file is the source of truth for configurable values.
# `app/core/config.py` defines the schema and loads these variables.

# Application
APP_NAME=C3 LegalDoc Navigator
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Security
SECRET_KEY=change-me-to-a-long-random-secret
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# PostgreSQL — Neon (or any hosted Postgres). Set DATABASE_URL directly.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=legaldoc
POSTGRES_PASSWORD=legaldoc_secret
POSTGRES_DB=legaldoc_navigator
DATABASE_URL=
DATABASE_SYNC_URL=

# Vector store — pgvector (local) or qdrant (production)
VECTOR_BACKEND=pgvector
VECTOR_DIMENSION=1536
VECTOR_TABLE_NAME=document_embeddings

# Qdrant Cloud (set VECTOR_BACKEND=qdrant on Render)
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=document_embeddings

# =============================================================================
# LLM & EMBEDDINGS — set all keys, models, and routing here (not in config.py).
# =============================================================================
# Embeddings: EMBEDDING_PROVIDER picks which API key + embedding model below.
# Chat:       DEFAULT_LLM_PROVIDER picks which API key + chat model below.

# OpenAI (used when EMBEDDING_PROVIDER=openai or DEFAULT_LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic (used when DEFAULT_LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-20241022

# Gemini / Google (used when EMBEDDING_PROVIDER=gemini/google or DEFAULT_LLM_PROVIDER=google)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Groq (used when DEFAULT_LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Azure OpenAI (used when DEFAULT_LLM_PROVIDER=azureopenai)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
AZURE_OPENAI_CHAT_MODEL=gpt-4o-mini

# Provider routing
EMBEDDING_PROVIDER=openai
DEFAULT_LLM_PROVIDER=openai
FALLBACK_LLM_PROVIDER=anthropic

# RAG
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
TOP_K_RETRIEVAL=5
SIMILARITY_THRESHOLD=0.7
SCOPED_SIMILARITY_THRESHOLD=0.45
SCOPED_TOP_K_RETRIEVAL=10
ENABLE_CONTEXT_COMPRESSION=true
MAX_CONTEXT_TOKENS=6000
CONTEXT_COMPRESSION_RELEVANCE_THRESHOLD=0.15
CONTEXT_COMPRESSION_NEAR_DUPLICATE_JACCARD_THRESHOLD=0.90
CONTEXT_COMPRESSION_MIN_SENTENCE_CHARS=20

# Ingestion
STORAGE_BACKEND=local
UPLOAD_DIR=./data/uploads
TEMP_UPLOAD_DIR=./tmp/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=["pdf","docx","txt"]

# S3-compatible storage (set STORAGE_BACKEND=s3 on Render; works with AWS S3 / Cloudflare R2)
S3_ENDPOINT_URL=
S3_BUCKET=legal-documents
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
S3_REGION=auto
S3_PATH_PREFIX=uploads

# Supabase Storage (optional legacy backend when STORAGE_BACKEND=supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=legal-documents
SUPABASE_STORAGE_PATH_PREFIX=uploads

# Guardrails
ENABLE_GUARDRAILS=true
MAX_QUERY_LENGTH=2000
GUARDRAILS_RUN_SYNC=true

# Human handoff
HANDOFF_CONFIDENCE_THRESHOLD=0.70

# Langfuse observability
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# RAG evaluation
EVAL_OUTPUT_DIR=./data/evaluation/results
EVAL_BENCHMARK_PATH=./data/evaluation/benchmark.json
EVAL_RAGAS_MODEL=gpt-4o-mini
EVAL_LATENCY_THRESHOLD_MS=5000
EVAL_COST_THRESHOLD_USD=0.05

# External legal databases (Model Context Protocol)
MCP_ENABLED=false
MCP_SEARCH_TIMEOUT_SECONDS=30
MCP_RETRY_MAX_ATTEMPTS=3
MCP_RETRY_MIN_WAIT_SECONDS=1
MCP_RETRY_MAX_WAIT_SECONDS=10
# JSON array of MCP server configs — example:
# MCP_SERVERS=[{"name":"courtlistener","transport":"sse","url":"https://api.example.com/mcp/sse","enabled":true,"search_tool":"search_cases","auth":{"type":"bearer","token_env":"COURTLISTENER_API_KEY"}}]
MCP_SERVERS=[]
